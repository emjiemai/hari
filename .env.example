# Copy to .env and fill in. .env is never committed.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# How Telegram reaches HARI: polling (your PC) or webhook (Render; render.yaml sets it).
# One token can't do both at once — use a separate test bot token on your PC while Render runs.
BOT_MODE=polling
# Webhook mode only: the public https address. On Render it is filled in by itself.
# WEBHOOK_BASE_URL=https://hari.onrender.com
# WEBHOOK_SECRET=any-long-random-text
# PORT=8080

# Database. Local/dev: SQLite file. Production: PostgreSQL — Render's own address works as is
# (postgres://… or postgresql://…?sslmode=require), e.g.
# DATABASE_URL=postgresql://hari:password@host:5432/hari
DATABASE_URL=sqlite+aiosqlite:///./hari.db

# Log file besides the console; empty = console only (Render)
LOG_FILE=logs/hari.log

# LLM through OpenRouter. Empty key = HARI still works, but answers with the
# approved source excerpt and a "send to a person" button instead of AI text (A12).
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.8-flash
LLM_FALLBACK_MODELS=google/gemini-3.7-flash

# Folder with knowledge documents (markdown + front matter passport)
KNOWLEDGE_DIR=knowledge/samples

# Proactive message limit per employee per day (spec §10)
PROACTIVE_DAILY_LIMIT=2

# Emergency stop: true = no proactive messages, AI answers disabled (spec §1 readiness)
HARI_PAUSED=false

# Owners (the boss, the admin): Telegram IDs, comma-separated. HARI makes them owners at every start.
# Your ID: send /start to the bot. Removing an ID never demotes anyone.
HARI_OWNERS=

# Job applications: "we reply within N working days"
APPLY_REPLY_DAYS=3
